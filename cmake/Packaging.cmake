# Stage a relocatable tree. Qt/runtime deployment is done by tools/ci/package.py.
if(APPLE)
    set(STACKS_RUNTIME_DIR ".")
    set(STACKS_DATA_DIR "stacks.app/Contents/Resources")
    set(STACKS_LIBRARY_DIR "stacks.app/Contents/Frameworks")
    set_property(TARGET stacks PROPERTY INSTALL_RPATH "@executable_path/../Frameworks")
elseif(WIN32)
    set(STACKS_RUNTIME_DIR ".")
    set(STACKS_DATA_DIR "resources")
    set(STACKS_LIBRARY_DIR ".")
else()
    set(STACKS_RUNTIME_DIR "bin")
    set(STACKS_DATA_DIR "share/stacks")
    set(STACKS_LIBRARY_DIR "lib")
    set_property(TARGET stacks PROPERTY INSTALL_RPATH "$ORIGIN/../lib")
    install(FILES packaging/stacks.desktop DESTINATION share/applications)
    install(FILES assets/branding/stacks-icon.png
        DESTINATION share/icons/hicolor/1024x1024/apps RENAME stacks.png)
endif()

install(TARGETS stacks BUNDLE DESTINATION . RUNTIME DESTINATION "${STACKS_RUNTIME_DIR}")
install(FILES "${PDFIUM_IMPORTED_LIBRARY}" DESTINATION "${STACKS_LIBRARY_DIR}")
install(DIRECTORY assets/samples/ DESTINATION "${STACKS_DATA_DIR}/samples")
install(FILES packaging/THIRD_PARTY_NOTICES.md DESTINATION "${STACKS_DATA_DIR}/licenses")
install(DIRECTORY packaging/licenses/ DESTINATION "${STACKS_DATA_DIR}/licenses")
install(DIRECTORY assets/fonts/ DESTINATION "${STACKS_DATA_DIR}/licenses/fonts" FILES_MATCHING PATTERN "OFL-*.txt")
install(FILES "${PDFIUM_ROOT}/LICENSE" DESTINATION "${STACKS_DATA_DIR}/licenses/pdfium")
install(DIRECTORY "${PDFIUM_ROOT}/licenses/" DESTINATION "${STACKS_DATA_DIR}/licenses/pdfium/third-party")
